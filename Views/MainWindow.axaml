<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SH2EESetup.ViewModels"
        x:Class="SH2EESetup.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="820" Height="680"
        MinWidth="700" MinHeight="560"
        Title="Silent Hill 2: Enhanced Edition — Setup (Linux)">

    <DockPanel Margin="14">

        <!-- Header: game directory selection, shared by all tabs -->
        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="6"
                Background="#22000000" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Silent Hill 2 (PC) install folder"
                           FontWeight="Bold" FontSize="14" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" x:Name="GameDirBox"
                             Text="{Binding GameDirectory}"
                             Watermark="Path to the folder containing sh2pc.exe…" />
                    <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse…"
                            Margin="6,0,0,0" />
                    <Button Grid.Column="2" x:Name="AutoDetectButton" Content="Auto-detect"
                            Margin="6,0,0,0" />
                </Grid>
                <ComboBox x:Name="DetectedBox" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DetectedDirectories}"
                          PlaceholderText="Detected installs…" />
                <TextBlock Text="{Binding GameStatus}"
                           Foreground="{Binding GameStatusBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,8" CornerRadius="6"
                Background="#22000000" Margin="0,10,0,0">
            <StackPanel Spacing="6">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                             Height="6" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Main tabs -->
        <TabControl x:Name="MainTabs">
            <TabItem Header="Install / Maintenance">
                <ScrollViewer>
                    <StackPanel x:Name="InstallPanel" Spacing="10" Margin="4,8" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Configure">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,8">
                        <Button x:Name="LoadConfigButton" Content="Load current settings" />
                        <Button x:Name="SaveConfigButton" Content="Save d3d8.ini" />
                        <Button x:Name="SaveLaunchButton" Content="Save &amp; Launch Game" />
                        <Button x:Name="ResetConfigButton" Content="Reset to defaults" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <TabControl x:Name="ConfigTabs" Margin="4,8" />
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Linux / Proton">
                <ScrollViewer>
                    <StackPanel Spacing="12" Margin="8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="The enhancements rely on a native d3d8.dll wrapper. Under Wine/Proton, that DLL must be forced to load as 'native' or the mod won't engage. Apply this once per prefix." />
                        <TextBlock Text="{Binding PrefixStatus}" TextWrapping="Wrap"
                                   Foreground="CornflowerBlue" />
                        <Button x:Name="ApplyOverridesButton"
                                Content="Apply DLL overrides to detected prefix" />
                        <Separator />
                        <TextBlock FontWeight="Bold" Text="Add to Steam" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="SH2 isn't a Steam game, so adding it as a non-Steam shortcut gives you a Proton wrapper and one-click launch. The DLL-override launch option is filled in for you. (Restart Steam afterwards and force a Proton version in the game's Compatibility properties.)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddToSteamButton" Content="Add to Steam" />
                            <Button x:Name="LaunchSteamButton" Content="Launch via Steam" />
                        </StackPanel>
                        <Separator />
                        <TextBlock FontWeight="Bold"
                                   Text="Universal method — launch options" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="If the game isn't inside a detectable prefix (e.g. a loose copy run via a custom Proton mapping), paste this into your launcher's launch options instead:" />
                        <Border Padding="10" CornerRadius="4" Background="#33000000">
                            <SelectableTextBlock x:Name="LaunchOptionText"
                                                 Text="{Binding DllOverrideLaunchOption}"
                                                 FontFamily="monospace" />
                        </Border>
                        <Button x:Name="CopyLaunchOptionButton" Content="Copy to clipboard"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

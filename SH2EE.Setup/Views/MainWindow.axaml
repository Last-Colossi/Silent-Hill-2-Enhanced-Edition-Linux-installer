<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SH2EESetup.Setup.ViewModels"
        x:Class="SH2EESetup.Setup.Views.MainWindow"
        x:DataType="vm:WizardViewModel"
        Width="760" Height="600" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico"
        Background="#1C1D22"
        Title="Silent Hill 2: Enhanced Edition — Setup">

    <Window.Styles>
        <!-- Two parallax fog layers. The texture is a horizontally-seamless mirror tile, so
             two copies sized far wider than any screen (5800px) sit edge-to-edge and slide
             left in lockstep: when one scrolls fully off the left (off-screen), the other has
             replaced it and it resets unseen. No seam, no on-screen reset, fills any size. -->
        <Style Selector="Image.fog">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Stretch" Value="Fill" />
        </Style>
        <!-- Front layer (~14 px/s) -->
        <Style Selector="Image.l1a">
            <Style.Animations><Animation Duration="0:6:54" IterationCount="INFINITE" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="(Canvas.Left)" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="(Canvas.Left)" Value="-5800" /></KeyFrame>
            </Animation></Style.Animations>
        </Style>
        <Style Selector="Image.l1b">
            <Style.Animations><Animation Duration="0:6:54" IterationCount="INFINITE" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="(Canvas.Left)" Value="5800" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="(Canvas.Left)" Value="0" /></KeyFrame>
            </Animation></Style.Animations>
        </Style>
        <!-- Back layer (noticeably slower, ~8 px/s) -->
        <Style Selector="Image.l2a">
            <Style.Animations><Animation Duration="0:12:05" IterationCount="INFINITE" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="(Canvas.Left)" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="(Canvas.Left)" Value="-5800" /></KeyFrame>
            </Animation></Style.Animations>
        </Style>
        <Style Selector="Image.l2b">
            <Style.Animations><Animation Duration="0:12:05" IterationCount="INFINITE" Easing="LinearEasing">
                <KeyFrame Cue="0%"><Setter Property="(Canvas.Left)" Value="5800" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="(Canvas.Left)" Value="0" /></KeyFrame>
            </Animation></Style.Animations>
        </Style>
    </Window.Styles>

    <Panel ClipToBounds="True">

        <!-- Fog: two seamless-tile copies per layer, scrolling right-to-left, sized past 4K -->
        <Canvas ClipToBounds="True">
            <!-- Back layer (flipped vertically + fainter so it doesn't mirror the front) -->
            <Image Classes="fog l2a" Source="/Assets/fog.jpg" Width="5800" Height="1500"
                   Canvas.Top="-40" Opacity="0.15" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><ScaleTransform ScaleY="-1" /></Image.RenderTransform>
            </Image>
            <Image Classes="fog l2b" Source="/Assets/fog.jpg" Width="5800" Height="1500"
                   Canvas.Top="-40" Opacity="0.15" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform><ScaleTransform ScaleY="-1" /></Image.RenderTransform>
            </Image>
            <!-- Front layer -->
            <Image Classes="fog l1a" Source="/Assets/fog.jpg" Width="5800" Height="1500"
                   Canvas.Top="-40" Opacity="0.28" />
            <Image Classes="fog l1b" Source="/Assets/fog.jpg" Width="5800" Height="1500"
                   Canvas.Top="-40" Opacity="0.28" />
        </Canvas>

        <!-- Wizard content -->
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0" Background="#40000000" Padding="22,18">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding StepNumberText}" Opacity="0.55" FontSize="12"
                               Foreground="White" />
                    <TextBlock Text="{Binding StepTitle}" FontSize="21" FontWeight="Bold"
                               Foreground="White" />
                </StackPanel>
            </Border>

            <!-- Step content area -->
            <Panel Grid.Row="1" Margin="22,20">

                <!-- Home: shown instead of step 1 when the mod is already installed -->
                <StackPanel x:Name="HomePanel" IsVisible="False" Spacing="10">
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="White"
                               Text="The Enhanced Edition is installed for:" />
                    <TextBlock Text="{Binding GameDirectory}" TextWrapping="Wrap" FontSize="12"
                               Opacity="0.7" Foreground="White" Margin="0,-4,0,6" />

                    <Button x:Name="HomeModifyButton" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Modify or update the installation" FontWeight="SemiBold" />
                            <TextBlock Text="Add or remove components, or reinstall to pick up the latest versions."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HomeConfigButton" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Launch the Configuration tool" FontWeight="SemiBold" />
                            <TextBlock Text="Fine-tune the Enhanced Edition's settings — all 141 options across 9 tabs."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HomeUninstallButton" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Uninstall the Enhanced Edition" FontWeight="SemiBold" />
                            <TextBlock Text="Put Silent Hill 2 back the way it was. Your saves are kept."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HomeBackupButton" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Create offline installation files" FontWeight="SemiBold" />
                            <TextBlock Text="Download the Enhanced Edition files to a folder so you can reinstall later without internet, here or on another PC."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HomeDifferentFolderButton" Content="Use a different folder…"
                            HorizontalAlignment="Left" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Step 1: Locate -->
                <StackPanel x:Name="LocatePanel" Spacing="12">
                    <TextBlock Text="{Binding DetectStatus}" Foreground="{Binding DetectBrush}"
                               TextWrapping="Wrap" FontSize="14" />
                    <TextBlock Text="Installation folder" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding GameDirectory}"
                                 Watermark="The folder that contains sh2pc.exe…" />
                        <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse…" Margin="6,0,0,0" />
                    </Grid>
                    <StackPanel IsVisible="{Binding HasDetected}" Spacing="4">
                        <TextBlock Text="Detected installations" Opacity="0.7" FontSize="12" />
                        <ComboBox x:Name="DetectedBox" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DetectedDirectories}"
                                  PlaceholderText="Pick a detected installation…" />
                    </StackPanel>

                    <!-- Only offered once there is actually something installed here. Browse
                         and the detected list jump straight to the menu, so in practice this
                         is the route for a path typed in by hand. -->
                    <Border IsVisible="{Binding HasExistingInstall}" Margin="0,14,0,0"
                            Background="#33000000" CornerRadius="6" Padding="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="The Enhanced Edition is already installed here"
                                           FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Update it, open the Configuration tool, or remove it."
                                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" Foreground="White" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="HomeOptionsButton" Content="Show options…"
                                    MinWidth="130" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Step 2: Source -->
                <StackPanel x:Name="SourcePanel" Spacing="14" IsVisible="False">
                    <TextBlock Text="The Enhanced Edition files can be downloaded for you, or installed from a folder you already have."
                               TextWrapping="Wrap" FontSize="14" Opacity="0.9" />
                    <RadioButton GroupName="src" IsChecked="{Binding IsDownloadSource}">
                        <StackPanel>
                            <TextBlock Text="Download automatically (recommended)" FontWeight="SemiBold" />
                            <TextBlock Text="Get the latest files directly from the Silent Hill 2: Enhanced Edition servers."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <!-- Upstream's "back up installation files": the archives are downloaded
                         straight into this folder instead of temp, and kept. -->
                    <StackPanel IsVisible="{Binding IsDownloadSource}" Spacing="6" Margin="26,-6,0,0">
                        <CheckBox IsChecked="{Binding KeepOfflineBackup}"
                                  Content="Also keep the downloaded files for offline reinstalls" />
                        <StackPanel IsVisible="{Binding KeepOfflineBackup}" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding OfflineBackupDir}"
                                         Watermark="Folder to keep the downloaded files in…" />
                                <Button Grid.Column="1" x:Name="BackupBrowseButton" Content="Browse…"
                                        Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding OfflineBackupStatus}" Opacity="0.8" FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <RadioButton GroupName="src" IsChecked="{Binding IsLocalSource}">
                        <StackPanel>
                            <TextBlock Text="Install from a folder on this PC" FontWeight="SemiBold" />
                            <TextBlock Text="Use files you've already downloaded (a folder containing local_sh2ee.dat)."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <StackPanel IsVisible="{Binding IsLocalSource}" Spacing="6" Margin="26,0,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding LocalSourceDir}"
                                     Watermark="Folder containing local_sh2ee.dat…" />
                            <Button Grid.Column="1" x:Name="LocalBrowseButton" Content="Browse…" Margin="6,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding LocalSourceStatus}" Opacity="0.85" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 3: Install type -->
                <Panel x:Name="InstallTypePanel" IsVisible="False">

                <!-- Fetching the manifest takes a moment, and a silently greyed-out Next
                     reads as a broken button. Say what's happening instead. -->
                <StackPanel IsVisible="{Binding IsBusy}" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="Checking for the latest Enhanced Edition files…"
                               FontSize="15" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="This usually takes a couple of seconds."
                               FontSize="12" Opacity="0.7" Foreground="White"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="40,0" />
                </StackPanel>

                <Grid IsVisible="{Binding !IsBusy}" RowDefinitions="Auto,Auto,*">
                    <RadioButton Grid.Row="0" GroupName="kind" IsChecked="{Binding IsQuick}">
                        <StackPanel>
                            <TextBlock Text="Full install (recommended)" FontWeight="SemiBold" />
                            <TextBlock Text="Installs everything — the complete Enhanced Edition experience."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Row="1" GroupName="kind" IsChecked="{Binding IsCustom}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Choose components" FontWeight="SemiBold" />
                            <TextBlock Text="Pick exactly which parts of the Enhanced Edition to install."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <Border Grid.Row="2" IsVisible="{Binding IsCustom}" Margin="0,12,0,0"
                            BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Components}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" Margin="0,0,0,6" CornerRadius="4" Background="#30000000">
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding StatusLabel}" Opacity="0.6"
                                                                   FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                               Opacity="0.65" FontSize="12" MaxWidth="600"
                                                               HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
                </Panel>

                <!-- Step 4: Progress -->
                <Panel x:Name="ProgressPanel" IsVisible="False">
                    <StackPanel IsVisible="{Binding !InstallComplete}" Spacing="14"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressStatus}" TextWrapping="Wrap" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="White" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="10"
                                     IsVisible="{Binding IsBusy}" />
                        <Button x:Name="CancelInstallButton" Content="Cancel installation"
                                HorizontalAlignment="Center" MinWidth="160"
                                IsVisible="{Binding CanCancelOperation}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding InstallComplete}" Spacing="8"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="56" Foreground="MediumSeaGreen"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Installation complete!" FontSize="22" FontWeight="Bold"
                                   Foreground="MediumSeaGreen" HorizontalAlignment="Center" />
                        <TextBlock Text="Click Next to finish setting things up." Opacity="0.7"
                                   HorizontalAlignment="Center" Foreground="White" />
                    </StackPanel>
                </Panel>

                <!-- Step 5: Steam -->
                <StackPanel x:Name="SteamPanel" IsVisible="False" Spacing="14">
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="White"
                               Text="The Enhanced Edition is installed. One last optional step:" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.85" Foreground="White"
                               Text="Silent Hill 2 isn't a Steam game, but adding it to Steam lets you launch it through Proton in one click — and we'll fill in the launch options it needs to run correctly on Linux." />
                    <CheckBox IsChecked="{Binding AddToSteam}"
                              Content="Add Silent Hill 2 to Steam (recommended)" />
                    <Border Background="#33000000" CornerRadius="6" Padding="12" IsVisible="{Binding AddToSteam}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Goldenrod"
                                   Text="After you finish: restart Steam, then open the game's Properties → Compatibility and force a Proton version. Proton-GE or Proton Experimental are recommended." />
                    </Border>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Foreground="White"
                               Text="Clicking Finish opens the Configuration app, where you can fine-tune the experience." />
                </StackPanel>

                <!-- Standalone offline backup (reached from the Home menu) -->
                <Panel x:Name="BackupPanel" IsVisible="False">

                    <!-- Choices -->
                    <Grid IsVisible="{Binding !BackupComplete}" RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Foreground="White"
                                   Text="Download the Enhanced Edition files to keep. You can install from that folder later with no internet connection — on this PC or any other." />

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                            <TextBox Grid.Column="0" Text="{Binding BackupTargetDir}"
                                     Watermark="Folder to save the files in…" />
                            <Button Grid.Column="1" x:Name="BackupTargetBrowseButton" Content="Browse…"
                                    Margin="6,0,0,0" />
                        </Grid>

                        <!-- Rebuilding from disk avoids a ~4 GB download, so it leads when
                             the installation can account for itself. -->
                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,14,0,0"
                                    IsVisible="{Binding CanRepackage}">
                            <RadioButton GroupName="backupsrc" IsChecked="{Binding RepackageFromInstall}">
                                <StackPanel>
                                    <TextBlock Text="Rebuild from this installation (no download)"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Packages the files already on this PC. Fast, works offline, and every file is checked against the checksum upstream published for it."
                                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="620"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="backupsrc" IsChecked="{Binding ShowBackupComponentList}">
                                <StackPanel>
                                    <TextBlock Text="Download fresh copies" FontWeight="SemiBold" />
                                    <TextBlock Text="Fetches the packages from the Enhanced Edition servers. Slower, but gives a pristine set."
                                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="620"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Files to download" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,14,0,6"
                                   IsVisible="{Binding !CanRepackage}" />

                        <Border Grid.Row="3" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6"
                                IsVisible="{Binding ShowBackupComponentList}">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Components}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" Margin="0,0,0,6" CornerRadius="4"
                                                    Background="#30000000">
                                                <CheckBox IsChecked="{Binding IsSelected}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                                   Opacity="0.65" FontSize="12" MaxWidth="600"
                                                                   HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="4" IsVisible="{Binding IsBusy}" Spacing="8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding ProgressStatus}" Foreground="White" FontSize="13"
                                       TextWrapping="Wrap" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8" />
                            <Button x:Name="CancelBackupButton" Content="Cancel download"
                                    HorizontalAlignment="Center" MinWidth="150"
                                    IsVisible="{Binding CanCancelOperation}" />
                        </StackPanel>
                    </Grid>

                    <!-- Result -->
                    <ScrollViewer IsVisible="{Binding BackupComplete}">
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Offline files ready" FontSize="20" FontWeight="Bold"
                                       Foreground="MediumSeaGreen" HorizontalAlignment="Center" />
                            <Border Background="#33000000" CornerRadius="6" Padding="14">
                                <TextBlock Text="{Binding BackupSummary}" TextWrapping="Wrap"
                                           FontSize="13" Foreground="White" LineHeight="19" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>

                <!-- Uninstall (reached from step 1, outside the numbered flow) -->
                <Panel x:Name="UninstallPanel" IsVisible="False">

                    <!-- Choices -->
                    <ScrollViewer IsVisible="{Binding !UninstallComplete}">
                        <StackPanel Spacing="12">
                            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="White"
                                       Text="This removes the Enhanced Edition and puts Silent Hill 2 back the way it was. Your saved games are not touched." />

                            <CheckBox IsChecked="{Binding UninstallGameFiles}">
                                <StackPanel>
                                    <TextBlock Text="Remove the Enhanced Edition files" FontWeight="SemiBold" />
                                    <TextBlock Text="Deletes the mod's files from the game folder and restores your original sh2pc.exe."
                                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="600"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding UninstallDllOverrides}">
                                <StackPanel>
                                    <TextBlock Text="Clear the Wine DLL overrides" FontWeight="SemiBold" />
                                    <TextBlock Text="Undoes the prefix settings that made the mod load. Other overrides you set yourself are left alone."
                                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="600"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding UninstallSteamShortcut}">
                                <StackPanel>
                                    <TextBlock Text="Remove the Steam shortcut" FontWeight="SemiBold" />
                                    <TextBlock Text="Takes &quot;Silent Hill 2: Enhanced Edition&quot; back out of your Steam library."
                                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="600"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                            </CheckBox>

                            <Border Background="#33000000" CornerRadius="6" Padding="12"
                                    IsVisible="{Binding ShowMissingBackupWarning}">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Goldenrod"
                                           Text="We can't find a backup of your original sh2pc.exe, so the Enhanced Edition executable will stay behind. The game will still run — but for a completely stock install you'd need to restore sh2pc.exe from your disc or GOG copy." />
                            </Border>

                            <TextBlock Text="{Binding UninstallPlan}" TextWrapping="Wrap" FontSize="12"
                                       Opacity="0.75" Foreground="White" Margin="0,4,0,0" />

                            <StackPanel IsVisible="{Binding IsBusy}" Spacing="8" Margin="0,6,0,0">
                                <TextBlock Text="{Binding UninstallStatus}" Foreground="White" FontSize="13" />
                                <ProgressBar IsIndeterminate="True" Height="6" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Result -->
                    <ScrollViewer IsVisible="{Binding UninstallComplete}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding UninstallStatus}" FontSize="20" FontWeight="Bold"
                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                       Margin="0,10,0,0" Foreground="MediumSeaGreen" />
                            <Border Background="#33000000" CornerRadius="6" Padding="14">
                                <TextBlock Text="{Binding UninstallSummary}" TextWrapping="Wrap"
                                           FontSize="13" Foreground="White" LineHeight="19" />
                            </Border>
                            <TextBlock IsVisible="{Binding UninstallHadWarnings}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="Goldenrod"
                                       Text="Some steps need your attention — see the notes above." />
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Panel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#40000000" Padding="22,14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1" x:Name="BackButton" Content="Back" MinWidth="90"
                            IsEnabled="{Binding CanGoBack}" IsVisible="{Binding ShowNavigation}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2" x:Name="NextButton" Content="{Binding NextLabel}" MinWidth="120"
                            IsEnabled="{Binding CanGoNext}" IsVisible="{Binding ShowNavigation}"
                            Classes="accent" />
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>

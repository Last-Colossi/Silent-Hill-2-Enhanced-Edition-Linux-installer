<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>SH2EESetup.Setup</RootNamespace>
		<AssemblyName>SH2EESetup</AssemblyName>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

		<Version>1.3.0</Version>
		<InformationalVersion>1.3.0-linux</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="..\assets\icon.ico" Link="Assets\icon.ico" />
		<AvaloniaResource Include="..\assets\fog.jpg" Link="Assets\fog.jpg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.17" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SH2EE.Core\SH2EE.Core.csproj" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>SH2EESetup</RootNamespace>
		<AssemblyName>SH2EESetupLinux</AssemblyName>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

		<!-- Version tracks the upstream setup tool this port has parity with -->
		<Version>1.1.5</Version>
		<AssemblyVersion>1.1.5.0</AssemblyVersion>
		<FileVersion>1.1.5.0</FileVersion>
		<InformationalVersion>1.1.5-linux</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Resources\icon.ico" />
		<EmbeddedResource Include="Resources\config.xml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.17" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
	</ItemGroup>

</Project>
